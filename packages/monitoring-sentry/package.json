{
	"name": "@onlooker/monitoring-sentry",
	"private": true,
	"description": "The Sentry side of @onlooker/monitoring - the one package allowed to import @sentry/*",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./browser": "./src/browser.ts",
		"./worker": "./src/worker.ts"
	},
	"sideEffects": false,
	"scripts": {
		"lint": "biome check src",
		"lint:fix": "biome check --write src",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"clean": "rimraf node_modules .turbo"
	},
	"dependencies": {
		"@onlooker/monitoring": "workspace:*",
		"@sentry/core": "10.74.0"
	},
	"peerDependencies": {
		"@sentry/cloudflare": "10.74.0"
	},
	"peerDependenciesMeta": {
		"@sentry/cloudflare": {
			"optional": true
		}
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20250109.1",
		"@onlooker/config-biome": "workspace:*",
		"@onlooker/config-typescript": "workspace:*",
		"@sentry/cloudflare": "10.74.0",
		"typescript": "^5.6.3",
		"vitest": "^4.1.9"
	}
}
