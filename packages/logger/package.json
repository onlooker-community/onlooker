{
  "name": "@onlooker/logger",
  "private": true,
  "description": "Logger for Onlooker",
  "main": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "keywords": [
    "onlooker",
    "logger",
    "logging"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "types": "./dist/src/index.d.ts",
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "scripts": {
    "clean": "rimraf .turbo node_modules coverage dist",
    "lint": "eslint . --ext .ts,.js,.tsx,.jsx",
    "lint:fix": "eslint . --ext .ts,.js,.tsx,.jsx --fix",
    "lint:report": "eslint . --format json --output-file ../../lint-results/app-store.json",
    "typecheck": "tsc --noEmit",
    "build": "rimraf dist && vite build && tsc --project tsconfig.build.json",
    "test": "vitest run"
  },
  "author": "Onlooker Community <community@onlooker.dev>",
  "devDependencies": {
    "@onlooker/config-typescript": "workspace:*",
    "vite": "8.0.16",
    "vitest": "4.1.9"
  },
  "dependencies": {
    "pino": "10.3.1",
    "pino-opentelemetry-transport": "3.0.0",
    "pino-pretty": "13.1.3",
    "zod": "4.4.3"
  }
}
