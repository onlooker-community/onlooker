# D1 export backups (see docs/runbooks/2026-08-08-database-rebuild.md) -
# these can contain live emails and password hashes and must never be
# committed, even transiently before they're moved to secure storage.
*backup*.sql

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
# Runtime lock bd writes at the repo root. .beads/.gitignore already covers
# *.lock, but only inside .beads/ - this one lands outside its scope, so it
# showed up in every git status and was one `git add -A` away from a commit.
.beads.gate.lock

# Visual brainstorming companion scratch (superpowers)
.superpowers/
