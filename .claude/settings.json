{
  "enabledPlugins": {
    "typescript-architect@meaganewaller-marketplace": true,
    "ecosystem@onlooker-community": true
  },
  "extraKnownMarketplaces": {
    "meaganewaller-marketplace": {
      "source": {
        "source": "github",
        "repo": "meaganewaller/marketplace"
      }
    },
    "onlooker-community": {
      "source": {
        "source": "github",
        "repo": "onlooker-community/ecosystem"
      },
      "autoUpdate": true
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  }
}
