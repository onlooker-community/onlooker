{
	"compatibility_date": "2026-05-19",
	"compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
	"name": "onlooker-community-website",
	"main": "./sentry.server.config.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},

	// DSN is public (it is in the browser bundle). Recorded here so the
	// worker's withSentry wrapper is not one missing dashboard secret away
	// from silently shipping with no server-side Sentry. Must match the
	// string in sentry.client.config.ts.
	"vars": {
		"SENTRY_DSN": "https://70d0d23fb0468a859ab7977665b9b2d5@o4512074220371968.ingest.us.sentry.io/4512074226401280",
		"SENTRY_ENVIRONMENT": "production"
	},

	// onlooker.dev was attached in the Cloudflare dashboard and lived nowhere
	// else, so nothing in version control said how the marketing domain was
	// wired. Recorded here from the live configuration, not invented: one
	// custom domain, zone onlooker.dev.
	//
	// custom_domain rather than a plain pattern because that is what exists,
	// and the difference is not cosmetic - a custom domain has Cloudflare
	// create and manage the DNS record, while a plain route does not create
	// DNS at all. Getting that backwards is what left api-staging.onlooker.dev
	// unresolvable for days with a deployed worker, an existing route, and no
	// error anywhere.
	"routes": [{ "pattern": "onlooker.dev", "custom_domain": true }],

	// Both of these are currently ON, and they are declared because adding
	// `routes` above would otherwise turn them off. Wrangler infers
	// workers_dev as false whenever routes are present and workers_dev is not
	// set, and preview_urls defaults to matching workers_dev - so recording
	// the route without these would have silently removed
	// onlooker-community-website.<subdomain>.workers.dev and the preview URLs
	// on the next deploy, as a side effect of a change meant only to write
	// down what already existed.
	"workers_dev": true,
	"preview_urls": true,

	// traces must be named explicitly: while automatic tracing is in beta,
	// "enabled" turns on logs only. No head_sampling_rate, so it defaults to
	// tracing everything - correct at this volume.
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true
		}
	}
}
