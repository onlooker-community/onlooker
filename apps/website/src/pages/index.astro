---
import Layout from "../layouts/Layout.astro";

export const prerender = true;
---

<Layout
  title="Onlooker — AI Development Observability"
  description="Local observability and intelligence for AI-assisted development. Know what your agents are doing. Learn from every failure."
>
  <main>
    <p class="eyebrow">Coming Soon</p>

    <h1 class="headline">
      Your agents are<br />
      <em>learning the hard way.</em>
    </h1>

    <p class="subhead">
      Onlooker gives AI development agents the observability layer they're missing — catching
      failures, accumulating lessons, and making every agent smarter than the last.
    </p>

    <div class="form-wrap">
      <form class="form" id="signup-form">
        <input
          name="email"
          type="email"
          id="email-input"
          placeholder="your@email.com"
          required
          autocomplete="email"
          spellcheck="false"
        />
        <button type="submit" id="submit-btn">Notify me</button>
      </form>

      <div class="success" id="success-msg">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path
            d="M2 7l3.5 3.5L12 3.5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        You're on the list. We'll be in touch.
      </div>

      <div class="error" id="error-msg">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path
            d="M2 2l10 10M12 2L2 12"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        Submission failed. Please try again later.
      </div>

      <p class="form-note">No spam. Early access + launch updates only.</p>
    </div>

    <div class="pills">
      <span class="pill"><span class="pill-dot"></span>13+ plugins</span>
      <span class="pill"><span class="pill-dot"></span>Claude Code native</span>
      <span class="pill"><span class="pill-dot"></span>Local-first</span>
      <span class="pill"><span class="pill-dot"></span>Waypoint hint engine</span>
      <span class="pill"><span class="pill-dot"></span>Shared Playbooks</span>
      <span class="pill"><span class="pill-dot"></span>Open source plugins</span>
    </div>
  </main>
</Layout>

<script>
  const form = document.getElementById('signup-form') as HTMLFormElement | null;
  const btn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const success = document.getElementById('success-msg');
  const error = document.getElementById('error-msg');
  const emailInput = document.getElementById('email-input') as HTMLInputElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !btn || !success || !error || !emailInput) return;

    error.classList.remove('visible');
    btn.textContent = '...';
    btn.disabled = true;

    try {
      const response = await fetch('https://formsubmit.co/ajax/early@onlooker.dev', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ email: emailInput.value }),
      });

      if (response.ok) {
        form.classList.add('hidden');
        success.classList.add('visible');
      } else {
        throw new Error('non-ok response');
      }
    } catch {
      error.classList.add('visible');
      btn.textContent = 'Notify me';
      btn.disabled = false;
    }
  });
</script>

<style>
  main {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80px 24px 60px;
    text-align: center;
  }

  .eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 32px;
    opacity: 0;
    animation: fade-up 0.6s ease forwards 0.2s;
  }

  .headline {
    font-family: var(--sans);
    font-size: clamp(42px, 7vw, 84px);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--text-1);
    max-width: 800px;
    margin-bottom: 28px;
    opacity: 0;
    animation: fade-up 0.6s ease forwards 0.35s;
  }

  .headline em {
    font-style: normal;
    color: var(--accent);
  }

  .subhead {
    font-family: var(--sans);
    font-size: clamp(16px, 2vw, 20px);
    font-weight: 400;
    line-height: 1.6;
    color: var(--text-2);
    max-width: 560px;
    margin-bottom: 56px;
    opacity: 0;
    animation: fade-up 0.6s ease forwards 0.5s;
  }

  .form-wrap {
    width: 100%;
    max-width: 480px;
    opacity: 0;
    animation: fade-up 0.6s ease forwards 0.65s;
  }

  .form {
    display: flex;
    gap: 0;
    border: 1px solid var(--border-2);
    border-radius: 6px;
    overflow: hidden;
    background: var(--bg-2);
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }

  .form:focus-within {
    border-color: var(--accent);
    box-shadow:
      0 0 0 3px var(--accent-dim),
      0 0 32px var(--accent-glow);
  }

  .form input {
    flex: 1;
    padding: 14px 18px;
    background: transparent;
    border: none;
    outline: none;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--text-1);
    min-width: 0;
  }

  .form input::placeholder {
    color: var(--text-3);
  }

  .form button {
    padding: 14px 24px;
    background: var(--accent);
    border: none;
    border-left: 1px solid var(--border-2);
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #080c10;
    cursor: pointer;
    transition:
      background 0.15s,
      opacity 0.15s;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .form button:hover {
    background: #00f0c0;
  }

  .form button:active {
    opacity: 0.85;
  }

  .form-note {
    margin-top: 12px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-3);
    letter-spacing: 0.04em;
  }

  .success,
  .error {
    display: none;
    align-items: center;
    gap: 10px;
    font-family: var(--mono);
    font-size: 13px;
    justify-content: center;
    padding: 14px;
    border-radius: 6px;
  }

  .success {
    border: 1px solid rgba(0, 212, 170, 0.25);
    color: var(--accent);
    background: var(--accent-dim);
  }

  .error {
    border: 1px solid rgba(255, 0, 0, 0.25);
    background: rgba(255, 0, 0, 0.1);
    color: #ff4d4d;
  }

  .success.visible,
  .error.visible {
    display: flex;
  }

  .form.hidden {
    display: none;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin-top: 52px;
    max-width: 640px;
    opacity: 0;
    animation: fade-up 0.6s ease forwards 0.95s;
  }

  .pill {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-2);
    letter-spacing: 0.06em;
    padding: 6px 14px;
    border: 1px solid var(--border);
    border-radius: 100px;
    background: var(--bg-2);
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .pill-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.6;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .form {
      flex-direction: column;
    }
    .form button {
      border-left: none;
      border-top: 1px solid var(--border-2);
      padding: 13px;
    }
  }
</style>
