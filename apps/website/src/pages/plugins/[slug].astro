---
import type { PluginCategory } from "../../data/plugins";
import { allPlugins, pluginsBySlug } from "../../data/plugins";
import Layout from "../../layouts/Layout.astro";

export const prerender = true;

export function getStaticPaths() {
	return allPlugins.map((plugin) => ({ params: { slug: plugin.slug } }));
}

const { slug } = Astro.params;
const plugin = pluginsBySlug[slug as string];

const categoryLabel: Record<PluginCategory, string> = {
	memory: "Memory",
	analysis: "Analysis",
	safety: "Safety",
	testing: "Testing",
	governance: "Governance",
	quality: "Quality",
};
---

<Layout
  title={`${plugin.name} — Onlooker Plugins`}
  description={plugin.hero.subheadline}
>
  <main>
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep">/</span>
      <a href="/plugins">Plugins</a>
      <span class="sep">/</span>
      <span>{plugin.name}</span>
    </nav>

    <!-- Hero -->
    <header class="hero">
      <div class="hero-meta">
        <span class="category-badge">{categoryLabel[plugin.category]}</span>
        <span class="version">v{plugin.version}</span>
      </div>
      <p class="tagline">{plugin.tagline}</p>
      <h1>{plugin.hero.headline}</h1>
      <p class="subhead">{plugin.hero.subheadline}</p>

      <div class="install-block">
        <span class="install-label">Install</span>
        <span class="install-coming">Coming soon</span>
      </div>
    </header>

    <div class="content">

      <!-- Problem -->
      <section class="section">
        <h2 class="section-heading">Problem</h2>
        <p class="prose">{plugin.problem}</p>
      </section>

      <!-- How it works -->
      <section class="section">
        <h2 class="section-heading">How it works</h2>
        <ol class="steps">
          {plugin.howItWorks.map((step) => <li>{step}</li>)}
        </ol>
      </section>

      <!-- Optional: skill commands (Cartographer) -->
      {
        plugin.skillCommands && (
          <section class="section">
            <h2 class="section-heading">Skill</h2>
            <pre class="code-block"><code>{plugin.skillCommands}</code></pre>
          </section>
        )
      }

      <!-- Optional: intervention example (Compass) -->
      {
        plugin.interventionExample && (
          <section class="section">
            <h2 class="section-heading">Intervention example</h2>
            <blockquote class="intervention">
              <pre>{plugin.interventionExample}</pre>
            </blockquote>
          </section>
        )
      }

      <!-- Tables (finding types, judge types, enforcement modes) -->
      {
        plugin.tables?.map((table) => (
          <section class="section">
            <h2 class="section-heading">{table.title}</h2>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>{table.headers[0]}</th>
                    <th>{table.headers[1]}</th>
                  </tr>
                </thead>
                <tbody>
                  {table.rows.map(([col1, col2]) => (
                    <tr>
                      <td><code>{col1}</code></td>
                      <td>{col2}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        ))
      }

      <!-- Key capabilities -->
      <section class="section">
        <h2 class="section-heading">Key capabilities</h2>
        <ul class="capabilities">
          {plugin.capabilities.map((cap) => <li>{cap}</li>)}
        </ul>
      </section>

      <!-- Optional: ideal for (Archivist) -->
      {
        plugin.idealFor && (
          <section class="section">
            <h2 class="section-heading">Ideal for</h2>
            <p class="prose">{plugin.idealFor}</p>
          </section>
        )
      }

      <!-- Events emitted -->
      {
        plugin.events && plugin.events.length > 0 && (
          <section class="section">
            <h2 class="section-heading">Events emitted</h2>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Event type</th>
                    <th>When</th>
                    {plugin.events.some((e) => e.keyFields) && <th>Key fields</th>}
                  </tr>
                </thead>
                <tbody>
                  {plugin.events.map((ev) => (
                    <tr>
                      <td><code>{ev.type}</code></td>
                      <td>{ev.when}</td>
                      {plugin.events?.some((e) => e.keyFields) && (
                        <td><code class="dim">{ev.keyFields ?? '—'}</code></td>
                      )}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )
      }

      <!-- Configuration -->
      {
        plugin.config && (
          <section class="section">
            <h2 class="section-heading">Configuration</h2>
            <pre class="code-block"><code>{plugin.config}</code></pre>
          </section>
        )
      }

      <!-- Tags -->
      <div class="tags">
        {plugin.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>

      <!-- Docs CTA -->
      <div class="docs-cta">
        <span class="docs-label">Full documentation</span>
        <a
          class="docs-link"
          href={`https://docs.onlooker.dev/plugins/${plugin.slug}`}
          target="_blank"
          rel="noopener"
        >
          docs.onlooker.dev/plugins/{plugin.slug} →
        </a>
      </div>

    </div>
  </main>
</Layout>

<style>
  main {
    flex: 1;
    max-width: 760px;
    margin: 0 auto;
    padding: 48px 24px 100px;
    width: 100%;
  }

  /* Breadcrumb */
  .breadcrumb {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-3);
    letter-spacing: 0.06em;
    margin-bottom: 40px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .breadcrumb a {
    color: var(--text-3);
    text-decoration: none;
    transition: color 0.15s;
  }

  .breadcrumb a:hover {
    color: var(--accent);
  }

  .sep {
    opacity: 0.4;
  }

  /* Hero */
  .hero {
    margin-bottom: 72px;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
  }

  .category-badge {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    padding: 3px 9px;
    border: 1px solid rgba(0, 212, 170, 0.3);
    border-radius: 3px;
  }

  .version {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--text-3);
    letter-spacing: 0.08em;
  }

  .tagline {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-2);
    letter-spacing: 0.06em;
    font-style: italic;
    margin-bottom: 16px;
  }

  h1 {
    font-family: var(--sans);
    font-size: clamp(28px, 5vw, 48px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text-1);
    margin-bottom: 20px;
  }

  .subhead {
    font-family: var(--sans);
    font-size: 17px;
    line-height: 1.65;
    color: var(--text-2);
    max-width: 600px;
    margin-bottom: 36px;
  }

  .install-block {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    border: 1px solid var(--border-2);
    border-radius: 6px;
    padding: 10px 18px;
    background: var(--bg-2);
  }

  .install-label {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-3);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .install-coming {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-2);
    letter-spacing: 0.04em;
    opacity: 0.6;
  }

  /* Content sections */
  .content {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .section-heading {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-3);
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }

  .prose {
    font-family: var(--sans);
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-2);
  }

  /* Steps */
  .steps {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
    counter-reset: step;
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
  }

  .steps li {
    counter-increment: step;
    display: flex;
    gap: 20px;
    padding: 18px 24px;
    font-family: var(--sans);
    font-size: 14px;
    line-height: 1.55;
    color: var(--text-2);
    border-bottom: 1px solid var(--border);
    background: var(--bg-2);
    transition: background 0.15s;
  }

  .steps li:last-child {
    border-bottom: none;
  }

  .steps li:hover {
    background: var(--bg-3);
  }

  .steps li::before {
    content: counter(step);
    font-family: var(--mono);
    font-size: 11px;
    color: var(--accent);
    min-width: 20px;
    padding-top: 1px;
    opacity: 0.7;
  }

  /* Capabilities */
  .capabilities {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .capabilities li {
    font-family: var(--sans);
    font-size: 14px;
    line-height: 1.55;
    color: var(--text-2);
    padding-left: 20px;
    position: relative;
  }

  .capabilities li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-size: 18px;
    line-height: 1.2;
  }

  /* Tables */
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 6px;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--sans);
    font-size: 13px;
  }

  thead tr {
    background: var(--bg-3);
  }

  th {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
    padding: 12px 20px;
    text-align: left;
    border-bottom: 1px solid var(--border);
  }

  td {
    padding: 14px 20px;
    color: var(--text-2);
    border-bottom: 1px solid var(--border);
    line-height: 1.5;
    vertical-align: top;
  }

  tr:last-child td {
    border-bottom: none;
  }

  tbody tr {
    background: var(--bg-2);
    transition: background 0.12s;
  }

  tbody tr:hover {
    background: var(--bg-3);
  }

  td code, th code {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--accent);
  }

  td code.dim {
    color: var(--text-3);
    font-size: 11px;
  }

  /* Code blocks */
  .code-block {
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 24px;
    overflow-x: auto;
  }

  .code-block code {
    font-family: var(--mono);
    font-size: 12px;
    line-height: 1.7;
    color: var(--text-2);
    white-space: pre;
  }

  /* Intervention example */
  .intervention {
    background: var(--bg-2);
    border: 1px solid var(--border-2);
    border-left: 3px solid var(--accent);
    border-radius: 0 6px 6px 0;
    padding: 20px 24px;
    overflow-x: auto;
  }

  .intervention pre {
    font-family: var(--mono);
    font-size: 12px;
    line-height: 1.7;
    color: var(--text-2);
    white-space: pre-wrap;
    margin: 0;
  }

  /* Tags */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--text-3);
    letter-spacing: 0.06em;
    padding: 4px 10px;
    border: 1px solid var(--border);
    border-radius: 3px;
    background: var(--bg-2);
  }

  /* Docs CTA */
  .docs-cta {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 24px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-2);
  }

  .docs-label {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
    flex-shrink: 0;
  }

  .docs-link {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--accent);
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: opacity 0.15s;
  }

  .docs-link:hover {
    opacity: 0.75;
  }

  @media (max-width: 640px) {
    main {
      padding: 32px 20px 64px;
    }

    .docs-cta {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
</style>
