---
import { MARKETPLACE_REQUIRED } from "astro:env/server";
import type { PluginCategory, PluginPage } from "../../data/plugins";
import { joinPlugins } from "../../data/plugins";
import Layout from "../../layouts/Layout.astro";
import { readMarketplace } from "../../lib/marketplace";

export const prerender = true;

export async function getStaticPaths() {
	const { plugins } = await readMarketplace({ required: MARKETPLACE_REQUIRED });
	return joinPlugins(plugins, { required: MARKETPLACE_REQUIRED }).map(
		(plugin) => ({
			params: { slug: plugin.slug },
			props: { plugin },
		}),
	);
}

const { plugin } = Astro.props as { plugin: PluginPage };

const categoryLabel: Record<PluginCategory, string> = {
	substrate: "Required",
	memory: "Memory",
	analysis: "Analysis",
	safety: "Safety",
	testing: "Testing",
	governance: "Governance",
	quality: "Quality",
};
---

<Layout
  title={`${plugin.name} — Onlooker Plugins`}
  description={plugin.description}
>
  <main>
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep">/</span>
      <a href="/plugins/">Plugins</a>
      <span class="sep">/</span>
      <span>{plugin.name}</span>
    </nav>

    <header class="hero">
      <div class="hero-meta">
        <span class="category-badge">{categoryLabel[plugin.category]}</span>
        <span class="version">v{plugin.version} on main</span>
      </div>
      <p class="tagline">{plugin.tagline}</p>
      <h1>{plugin.name}</h1>
      <p class="subhead">{plugin.description}</p>

      <div class="install-block">
        <span class="install-label">Install</span>
        <code class="install-command">/plugin install {plugin.slug}@onlooker-community</code>
      </div>
    </header>

    <div class="content">
      <section class="section">
        <h2 class="section-heading">Problem</h2>
        <p class="prose">{plugin.problem}</p>
      </section>

      <section class="section">
        <h2 class="section-heading">How it works</h2>
        <ol class="steps">
          {plugin.howItWorks.map((step) => <li>{step}</li>)}
        </ol>
      </section>

      <div class="docs-cta">
        <span class="docs-label">Full documentation</span>
        <a class="docs-link" href={plugin.readmeUrl} target="_blank" rel="noopener">
          The {plugin.name} README on GitHub →
        </a>
      </div>
    </div>
  </main>
</Layout>

<style>
  main {
    flex: 1;
    max-width: 760px;
    margin: 0 auto;
    padding: 48px 24px 100px;
    width: 100%;
  }

  /* Breadcrumb */
  .breadcrumb {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-3);
    letter-spacing: 0.06em;
    margin-bottom: 40px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .breadcrumb a {
    color: var(--text-3);
    text-decoration: none;
    transition: color 0.15s;
  }

  .breadcrumb a:hover {
    color: var(--accent);
  }

  .sep {
    opacity: 0.4;
  }

  /* Hero */
  .hero {
    margin-bottom: 72px;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
  }

  .category-badge {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    padding: 3px 9px;
    border: 1px solid rgba(0, 212, 170, 0.3);
    border-radius: 3px;
  }

  .version {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--text-3);
    letter-spacing: 0.08em;
  }

  .tagline {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-2);
    letter-spacing: 0.06em;
    font-style: italic;
    margin-bottom: 16px;
  }

  h1 {
    font-family: var(--display);
    font-size: 32px;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: 0;
    color: var(--text-1);
    margin-bottom: 20px;
  }

  @media (min-width: 768px) {
    h1 {
      font-size: 48px;
    }
  }

  .subhead {
    font-family: var(--sans);
    font-size: 17px;
    line-height: 1.65;
    color: var(--text-2);
    max-width: 600px;
    margin-bottom: 36px;
  }

  .install-block {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    border: 1px solid var(--border-2);
    border-radius: 6px;
    padding: 10px 18px;
    background: var(--bg-2);
  }

  .install-label {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-3);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .install-command {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-2);
    letter-spacing: 0.04em;
  }

  /* Content sections */
  .content {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .section-heading {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-3);
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }

  .prose {
    font-family: var(--sans);
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-2);
  }

  /* Steps */
  .steps {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
    counter-reset: step;
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
  }

  .steps li {
    counter-increment: step;
    display: flex;
    gap: 20px;
    padding: 18px 24px;
    font-family: var(--sans);
    font-size: 14px;
    line-height: 1.55;
    color: var(--text-2);
    border-bottom: 1px solid var(--border);
    background: var(--bg-2);
    transition: background 0.15s;
  }

  .steps li:last-child {
    border-bottom: none;
  }

  .steps li:hover {
    background: var(--bg-3);
  }

  .steps li::before {
    content: counter(step);
    font-family: var(--mono);
    font-size: 11px;
    color: var(--accent);
    min-width: 20px;
    padding-top: 1px;
    opacity: 0.7;
  }

  /* Docs CTA */
  .docs-cta {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 24px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-2);
  }

  .docs-label {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
    flex-shrink: 0;
  }

  .docs-link {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--accent);
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: opacity 0.15s;
  }

  .docs-link:hover {
    opacity: 0.75;
  }

  @media (max-width: 640px) {
    main {
      padding: 32px 20px 64px;
    }

    .docs-cta {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
</style>
