---
interface Props {
	label: string;
	href?: string;
	title?: string;
}

const { label, href, title } = Astro.props;
---

{
  href && title && (
    <p class="latest-link">
      {label}: <a href={href}>{title} →</a>
    </p>
  )
}

<style>
  .latest-link {
    margin-top: 28px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-2);
    letter-spacing: 0.04em;
    max-width: 560px;
    animation: fade-up 0.6s ease both 1.1s;
  }

  /* Two lines in a row read as one group, not two paragraphs. */
  .latest-link + .latest-link {
    margin-top: 8px;
  }

  .latest-link a {
    color: var(--text-1);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .latest-link a:hover,
  .latest-link a:focus-visible {
    color: var(--accent);
  }
</style>
