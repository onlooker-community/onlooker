---
import "../styles/globals.css";
import { SITE_URL } from "../lib/site";

interface Props {
	title: string;
	description: string;
	ogType?: "website" | "article";
	publishedTime?: Date;
	canonicalPath?: string;
}

const {
	title,
	description,
	ogType = "website",
	publishedTime,
	canonicalPath = Astro.url.pathname,
} = Astro.props;

const canonical = new URL(canonicalPath, SITE_URL).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    <link rel="alternate" type="application/rss+xml" title="Onlooker blog" href="/blog/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="page">
      <nav>
        <a class="logo" href="/">
          <span class="logo-pulse"></span>
          Onlooker
        </a>
        <div class="nav-right">
          <a class="nav-link" href="/plugins/">Plugins</a>
          <a class="nav-link" href="/blog/">Blog</a>
          <span class="nav-tag">Early Access</span>
        </div>
      </nav>

      <slot />

      <footer>
        <span class="footer-copy">© 2026 Onlooker Community</span>
        <div class="footer-links">
          <a href="https://github.com/onlooker-community" target="_blank" rel="noopener">GitHub</a>
          <a href="mailto:community@onlooker.dev">Contact</a>
        </div>
        <p class="credit">
          Icons by <a href="https://crusenho.itch.io">Crusenho Agus Hennihuno</a>,
          <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.
        </p>
      </footer>
    </div>

    <div class="radar">
      <div class="radar-sweep"></div>
    </div>
  </body>
</html>
