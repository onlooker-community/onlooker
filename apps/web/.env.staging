# Staging defaults, loaded by `vite build --mode staging` (pnpm build:staging).
#
# This file is the whole reason staging is a distinct build. VITE_API_BASE_URL
# is inlined at build time, so a bundle cannot be pointed at a different API
# after the fact - the per-environment vars in wrangler.toml never could have
# done it, which is why app-staging.onlooker.dev was serving a bundle built
# against api.onlooker.dev and writing to the production database.
#
# Everything except the API URL deliberately matches .env.production: staging
# earns its keep by rehearsing production, and a staging build that logs more
# or mocks anything is rehearsing something else.
VITE_API_BASE_URL=https://api-staging.onlooker.dev
VITE_USE_MOCK_API=false
VITE_API_LOG_REQUESTS=false
