# Web app API configuration.
# Copy to `.env.local` (git-ignored) to override for your machine.
# All values are optional — sensible per-environment defaults are built in.

# Base URL of the API. Leave empty to use the in-memory mock API.
VITE_API_BASE_URL=

# Force the mock API on/off. Defaults to on when VITE_API_BASE_URL is empty.
VITE_USE_MOCK_API=

# Per-request timeout in milliseconds (default: 15000).
VITE_API_TIMEOUT_MS=

# Max automatic retries for transient failures — network, 5xx, 429 (default: 2).
VITE_API_MAX_RETRIES=

# Exponential backoff tuning in milliseconds (defaults: 300 base, 5000 max).
VITE_API_RETRY_BASE_DELAY_MS=
VITE_API_RETRY_MAX_DELAY_MS=

# localStorage keys for the token pair (defaults: auth_token / auth_refresh_token).
VITE_AUTH_TOKEN_KEY=
VITE_AUTH_REFRESH_KEY=

# Log API calls to the console with tokens redacted (default: on in dev).
VITE_API_LOG_REQUESTS=
