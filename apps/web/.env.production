# Production defaults. Override VITE_API_BASE_URL at build time for staging.
VITE_API_BASE_URL=https://api.onlooker.dev
VITE_USE_MOCK_API=false
VITE_API_LOG_REQUESTS=false

# Where error reports and traces go. Public by design - a DSN is an ingest
# address, and it ships in the bundle either way. Left out of
# .env.development so local work does not fill the project with noise; set it
# in .env.local to try monitoring on your machine.
VITE_MONITORING_DSN=https://181459c97bdebf4bf0992e78cf8f183f@o4512074220371968.ingest.us.sentry.io/4512075991547904
