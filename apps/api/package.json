		"bcryptjs": "^2.4.3",
		"jose": "^5.4.0"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.20.3",
		"@cloudflare/workers-types": "^4.20250109.1",
		"@onlooker/config-biome": "workspace:*",
		"@onlooker/config-typescript": "workspace:*",
		"@types/bcryptjs": "^2.4.6",
		"@types/node": "^25.9.3",
		"typescript": "^5.6.3",
		"vitest": "^4.1.9",
		"wrangler": "^4"
	}
}
